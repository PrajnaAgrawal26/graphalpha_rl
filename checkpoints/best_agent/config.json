{
  "name": "nse_v2_nse_advanced",
  "seed": 1,
  "out_dir": "runs",
  "agent": "ppo",
  "data_path": "data/nse100.npz",
  "horizon": 20,
  "train": [
    "2012-01-01",
    "2019-12-31"
  ],
  "valid": [
    "2020-01-01",
    "2021-12-31"
  ],
  "test": [
    "2022-01-01",
    "2024-06-30"
  ],
